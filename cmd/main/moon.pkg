// `spell` command-line front end.
import {
  "Careylq/spell/src/api",
  "moonbitlang/core/env",
  "moonbitlang/x/fs",
  "moonbitlang/x/sys",
  "moonbitlang/x/unicode",
}

import {
  "moonbitlang/x/unicode",
} for "wbtest"

// `--words -` reads stdin in chunks instead of seeking for its size, so that a
// pipe works on the native backend. See docs/MOONBIT_GOTCHAS.md #33.
pkgtype(kind: "executable")

options(
  "native-stub": [ "stdin_native.c" ],
)
